# ─────────────────────────────────────────────────────────────────────────────
# SmartSchedule — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ─────────────────────────────────────────────────────────────
PROJECT_NAME=SmartSchedule API
ENVIRONMENT=development          # development | staging | production

# ─── Database ─────────────────────────────────────────────────────────────────
# Use Supabase PostgreSQL connection string OR a local PostgreSQL instance
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/smartschedule

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from your Supabase project dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440          # 24 hours

# ─── AI (Google Gemini) ──────────────────────────────────────────────────────
# Get from: https://makersuite.google.com/app/apikey
AI_API_KEY=
AI_MODEL=gemini-1.5-pro

# ─── Firebase Cloud Messaging (for push notifications) ───────────────────────
# Get from Firebase Console → Project Settings → Cloud Messaging
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Web Dashboard ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
